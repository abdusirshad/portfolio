# Copy to terraform.tfvars and fill in real values — never commit secrets
azure_location = "eastus"
aws_region     = "us-east-1"

# Get ACR ID: az acr show --name <acrname> --query id -o tsv
acr_id = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.ContainerRegistry/registries/<name>"

# Bastion public IP + VPN gateway egress IPs
api_server_authorized_ip_ranges = [
  "10.0.2.0/24",   # mgmt subnet (bastion)
  "203.0.113.0/30" # VPN gateway egress (replace with real)
]
